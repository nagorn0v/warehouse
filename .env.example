# Postgres: inventory (inventory_api source of truth)
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory_pass

# Postgres: analytics (analytics_worker cache)
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics_pass

# Redis (streams backend)
REDIS_URL=redis://redis:6379/0

# Analytics worker (consumer)
CONSUMER_GROUP=analytics
CONSUMER_NAME=analytics-worker
BATCH_SIZE=32
BLOCK_MS=5000